# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# --- database ---
POSTGRES_USER=bookworm
POSTGRES_PASSWORD=bookworm
POSTGRES_DB=bookworm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- app ---
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-real-environments
CORS_ORIGINS=http://localhost:5173

# --- book data provider ---
# Free token from https://hardcover.app -> account settings -> API.
# Rate limit is 60 requests/minute, so responses are cached server-side.
HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql
HARDCOVER_TOKEN=
